{
  "schemaPath": "Secrets.schema.json",
  "provider": "auto",
  "auto": {
    "order": ["env", "vault", "file"],
    "allowMerge": false
  },
  "file": {
    "sourcePath": "../your-secrets/Secrets.xcconfig"
  },
  "vault": {
    "addrEnv": "VAULT_ADDR",
    "tokenEnv": "VAULT_TOKEN",
    "pathEnv": "SECRETS_VAULT_PATH",
    "mountEnv": "SECRETS_VAULT_MOUNT",
    "kvVersion": 2
  },
  "cli": {
    "policy": "strict",
    "minVersion": "0.3.0"
  }
}
